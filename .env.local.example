# Copia este archivo a .env.local y llena los valores reales.
# NUNCA subas .env.local a git (ya está en .gitignore).

# URL del Google Apps Script Web App que recibe TODOS los leads del sitio
# (webinar, bootcamp, contacto, diagnóstico) y los escribe en Google Sheets.
# Cada lead lleva un campo "origen" para que el Apps Script sepa a qué
# pestaña del Sheet mandarlo. Ver snippet de Code.gs en el resumen del PR.
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/TU-DEPLOYMENT-ID/exec

# Link de registro del webinar evergreen en EverWebinar. Se usa en /webinar
# (redirect tras registrar el lead) y en el resultado "nuevo" del diagnóstico.
NEXT_PUBLIC_EVERWEBINAR_URL=

# Link de pago directo de Mercado Pago para el Bootcamp ($397 MXN).
# Se usa tal cual, sin checkout dinámico.
NEXT_PUBLIC_MERCADOPAGO_LINK=

# Número de WhatsApp del negocio, con código de país y sin espacios ni
# símbolos (ej. 5215512345678). Se usa para el link wa.me del segmento
# "empresario" del diagnóstico y en /ingresar.
NEXT_PUBLIC_WHATSAPP_NUMBER=
